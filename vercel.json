{
  "buildCommand": "cd client && npx expo export --platform web",
  "outputDirectory": "client/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/v1/panic-index/analyze.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
