{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["es2020", "dom"]
  },
  "include": ["api/**/*", "server/src/**/*"],
  "exclude": ["node_modules", "client"]
}
